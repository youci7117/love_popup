];

/* 生成彈窗 */
function spawnPopups() {

    /* 先將上一輪所有彈窗淡出＋壓底層 */
    document.querySelectorAll('.multi-popup').forEach(p => {
        p.classList.add("old-popup");
    });

    /* 本輪彈窗數量：2～4 */
    const count = Math.floor(Math.random() * 3) + 2;

    for (let i = 0; i < count; i++) {
        const popup = document.createElement("div");
        popup.className = "multi-popup";

        /* 隨機決定圖片 or 文字 */
        const isImage = Math.random() < 0.70; // 70% 圖片、30% 文字，可調整

        if (isImage) {
            const img = document.createElement("img");
            const file = popupImages[Math.floor(Math.random() * popupImages.length)];
            img.src = file;
            popup.appendChild(img);

            /* 圖片彈窗大小 */
            popup.style.width = "240px";
        } else {
            /* 文字彈窗大小 */
            popup.style.width = "180px";
            popup.style.fontSize = "20px";
            popup.style.fontWeight = "600";
            popup.innerText = popupTexts[Math.floor(Math.random() * popupTexts.length)];
        }

        /* 隨機位置 */
        const maxX = window.innerWidth - 260;
        const maxY = window.innerHeight - 180;

        popup.style.left = Math.random() * maxX + "px";
        popup.style.top  = Math.random() * maxY + "px";
        popup.style.position = "fixed";

        /* 部分重疊但不完全蓋住（隨機旋轉一點） */
        popup.style.transform = `rotate(${(Math.random()*6 - 3)}deg)`;

        document.body.appendChild(popup);
    }
}

/* 每 2.5 秒換一輪彈窗 */
setInterval(spawnPopups, 2500);
